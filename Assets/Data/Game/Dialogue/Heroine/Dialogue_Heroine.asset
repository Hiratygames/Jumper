    firstTalks:
    - "\u3042\u3089\u3001\u30B9\u30E9\u30A4\u30E0\u541B"
    - "\u3054\u6A5F\u5ACC\u3044\u304B\u304C\uFF1F"
    - "\u306D\u3048\u3001\u77E5\u3063\u3066\u308B\uFF1F"
